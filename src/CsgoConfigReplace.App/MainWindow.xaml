<Window x:Class="CsgoConfigReplace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CsgoConfigReplace.App.ViewModels"
        mc:Ignorable="d"
        Title="CS2 Config 迁移工具" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/app_icon.png">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- Steam Path -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Steam 路径：" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="浏览..." Command="{Binding BrowseSteamPathCommand}" Margin="4,0" Padding="12,4"/>
                <Button Content="重新扫描" Command="{Binding ScanAccountsCommand}" Margin="4,0" Padding="12,4"/>
            </StackPanel>
            <TextBox Text="{Binding SteamPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="4"/>
        </DockPanel>

        <!-- Action Bar -->
        <Border Grid.Row="1" Background="#FFF5F5F5" Padding="8" Margin="0,0,0,8" CornerRadius="4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="将选中账号设为基准"
                        Command="{Binding SetBaselineCommand}"
                        Padding="12,6"
                        Margin="0,0,8,0"/>
                <Button Content="一键应用到勾选账号"
                        Command="{Binding ApplyCommand}"
                        Background="#FF2E7D32"
                        Foreground="White"
                        Padding="12,6"
                        Margin="0,0,16,0"/>
                <CheckBox Content="自动检测新登录账号并应用基准配置"
                          IsChecked="{Binding IsAutoMonitorEnabled, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>
                <TextBlock Text="{Binding MonitorStatus}"
                           Foreground="Gray"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Account List -->
            <GroupBox Grid.Column="0" Header="Steam 账号列表（勾选目标账号）" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                        <DataGridTextColumn Header="昵称" Binding="{Binding Nickname}" IsReadOnly="True" Width="120"/>
                        <DataGridTextColumn Header="SteamID3" Binding="{Binding SteamId3}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding DisplayStatus}" IsReadOnly="True" Width="120"/>
                        <DataGridTextColumn Header="文件数" Binding="{Binding FileCount}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="最后修改" Binding="{Binding LastWriteTimeText}" IsReadOnly="True" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Baseline Panel -->
            <GroupBox Grid.Column="1" Header="基准配置">
                <StackPanel Margin="8">
                    <TextBlock Text="{Binding BaselineSummary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="选择外部config文件夹"
                                Command="{Binding BrowseExternalBaselineCommand}"
                                Padding="8,4"
                                Margin="0,0,4,0"/>
                        <Button Content="清除"
                                Command="{Binding ClearExternalBaselineCommand}"
                                Padding="8,4"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ExternalBaselinePath}"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="基准配置文件（勾选需要复制的文件）：" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding CurrentBaselineFiles}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding FileName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar IsIndeterminate="{Binding IsBusy}" Width="120" Height="12" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Operation Log -->
        <GroupBox Grid.Row="4" Header="操作日志" Margin="0,8,0,0">
            <ListBox ItemsSource="{Binding OperationLog}" FontFamily="Consolas" FontSize="12"/>
        </GroupBox>
    </Grid>
</Window>
